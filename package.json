{
  "name": "@smartslash/astro-smart-colors",
  "version": "0.3.0",
  "description": "OKLCH color system for Astro: accessible semantic tokens generated from a small editable palette",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/SMartSlash/astro-smart-colors.git" },
  "homepage": "https://github.com/SMartSlash/astro-smart-colors#readme",
  "bugs": { "url": "https://github.com/SMartSlash/astro-smart-colors/issues" },
  "keywords": ["astro", "oklch", "design-tokens", "accessibility", "contrast", "wcag"],
  "files": ["src", "examples", "docs", "README.md", "CHANGELOG.md", "LICENSE"],
  "type": "module",
  "main": "./src/astro-integration.mjs",
  "types": "./src/astro-integration.d.ts",
  "exports": {
    ".": {
      "types": "./src/astro-integration.d.ts",
      "default": "./src/astro-integration.mjs"
    },
    "./generate": {
      "types": "./src/generate-colors.d.ts",
      "default": "./src/generate-colors.mjs"
    },
    "./config": {
      "types": "./src/defaults.d.ts",
      "default": "./src/defaults.mjs"
    },
    "./report": {
      "default": "./src/report-data.mjs"
    },
    "./audit": {
      "default": "./src/browser-audit.mjs"
    }
  },
  "bin": {
    "smart-colors": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "astro": ">=5",
    "playwright": ">=1.40",
    "@playwright/test": ">=1.40"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
