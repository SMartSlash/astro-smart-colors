{
  "name": "@smartslash/astro-smart-colors",
  "version": "0.4.0",
  "description": "OKLCH color system for Astro: accessible semantic tokens generated from a small editable palette",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/SMartSlash/astro-smart-colors.git" },
  "homepage": "https://github.com/SMartSlash/astro-smart-colors#readme",
  "bugs": { "url": "https://github.com/SMartSlash/astro-smart-colors/issues" },
  "keywords": ["astro", "oklch", "design-tokens", "accessibility", "contrast", "wcag"],
  "files": ["src", "examples", "docs", "README.md", "CHANGELOG.md", "LICENSE"],
  "type": "module",
  "main": "./src/astro-integration.mjs",
  "types": "./src/astro-integration.d.ts",
  "exports": {
    ".": {
      "types": "./src/astro-integration.d.ts",
      "default": "./src/astro-integration.mjs"
    },
    "./generate": {
      "types": "./src/colors/generate-colors.d.ts",
      "default": "./src/colors/generate-colors.mjs"
    },
    "./config": {
      "types": "./src/colors/defaults.d.ts",
      "default": "./src/colors/defaults.mjs"
    },
    "./report": {
      "default": "./src/diagnostics/report-data.mjs"
    },
    "./audit": {
      "default": "./src/diagnostics/browser/browser-audit.mjs"
    }
  },
  "bin": {
    "smart-colors": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:browser": "node scripts/run-tests.mjs browser --native --browser=chromium,webkit",
    "test:site": "node scripts/run-tests.mjs site --browser=chromium"
  },
  "peerDependencies": {
    "astro": ">=5"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
